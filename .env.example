# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: OpenAI text-embedding-3-small for semantic headline dedup.
# Without it the curator falls back to title-word overlap dedup.
OPENAI_API_KEY=

# ── TTS ──────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Optional overrides for the voice IDs in config/voices.yaml
CLAIRE_VOICE_ID=
FLINT_VOICE_ID=

# ── Cross-coverage search (optional; coverage_count defaults to 1 without it) ─
SERPER_API_KEY=

# ── Operator notifications (optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Publishing target ────────────────────────────────────────────────────────
# Leave S3_BUCKET empty to publish to ./output/site instead (local dev).
S3_BUCKET=
AWS_REGION=us-east-1
# Optional key prefix inside the bucket, e.g. "podcast" -> s3://bucket/podcast/feed.xml
S3_PREFIX=
# Public base URL that Spotify/Apple will fetch from. Defaults to the
# virtual-hosted S3 URL; set to your CloudFront/custom domain if you have one.
PUBLIC_BASE_URL=
# Local dev only: AWS credentials come from your normal AWS CLI profile.
# In GitHub Actions they come from OIDC (AWS_ROLE_ARN) or repo secrets.

# ── Safety valves ────────────────────────────────────────────────────────────
# Set to 1 to run even if the CFO monthly hard-pause threshold has been hit.
CW_IGNORE_BUDGET=0

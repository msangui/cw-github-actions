# ── Clerk (humans) ───────────────────────────────────────────────────────────
# Create an application at dashboard.clerk.com, enable "Google" as a social connection and
# (Clerk → SSO connections) add your Google Workspace domain as an enterprise/SAML or OAuth
# connection so only workspace accounts can sign in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Belt and braces: also reject any signed-in user whose primary email is not on this domain.
ALLOWED_EMAIL_DOMAIN=example.com

# ── GitHub (git is the source of truth) ─────────────────────────────────────
# Fine-grained PAT scoped to this one repo with: Contents (read+write), Actions (read+write),
# Metadata (read). Commits are authored by the token owner.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=msangui/cw-github-actions
GITHUB_BRANCH=main
GITHUB_WORKFLOW=daily-episode.yml

# ── Pipeline → panel live events ─────────────────────────────────────────────
# Shared secret. Same value goes into the repo secret PANEL_TOKEN; the repo variable PANEL_URL
# is this deployment's base URL (https://cw-admin.vercel.app).
PANEL_TOKEN=change-me-long-random

# ── Run store ────────────────────────────────────────────────────────────────
# Upstash Redis (Vercel Marketplace → Upstash). Leave both empty locally to use ./.data/.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Producer agent (the panel's own key; episode generation uses the repo secret) ──
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5

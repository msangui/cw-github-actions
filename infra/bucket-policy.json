{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadPodcastAssets",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/PREFIX_feed.xml",
        "arn:aws:s3:::BUCKET_NAME/PREFIX_feed-extended.xml",
        "arn:aws:s3:::BUCKET_NAME/PREFIX_cover.png",
        "arn:aws:s3:::BUCKET_NAME/PREFIX_episodes/*"
      ]
    }
  ]
}
